  </extension>

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="doctype">
    <facet name="archive">
      <schema name="archive"/>
    </facet>
    <doctype extends="Folder" name="Archive">
      <schema name="file"/>
      <facet name="archive"/>
    </doctype>
  </extension>
  -->

</component>
